# ─── CVlyze Environment Variables ─────────────────────────────────────────────

# Server
PORT=5000

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Atlas free tier: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cvlyze

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev:    redis://localhost:6379
# Upstash TLS:  rediss://:password@your-host.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ─── BullMQ Worker ────────────────────────────────────────────────────────────
# Number of jobs each worker process handles in parallel (default: 2)
WORKER_CONCURRENCY=2
